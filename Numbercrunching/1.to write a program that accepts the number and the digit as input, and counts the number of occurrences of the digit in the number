import java.util.Scanner;

public class Main{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        long num = sc.nextInt();
        int val = sc.nextInt();
        int count=0;
        while(num!=0){
            long temp= num%10;
            if(temp == val){
                count++;
            }
            num = num/10;
        }
        System.out.println(count);
    }
}