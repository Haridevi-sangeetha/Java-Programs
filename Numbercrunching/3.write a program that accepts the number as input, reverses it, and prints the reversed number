import java.util.Scanner;

public class Main{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        long num = sc.nextInt();
        long rev= 0;
        while(num!=0){
            long temp = num%10;
            rev= (rev*10)+temp;
            num/=10;
        }
        System.out.println(rev);
    }
}