import java.util.*;

public  class  Main{
    public static void main(String [] args){
        Scanner sc = new Scanner (System.in);
        int num = sc.nextInt();
        int og = num;
        int sum =0;
        while(num!=0){
            int temp = num%10;
            sum +=temp;
            num /=10;
        }
        if(og%sum==0){
            System.out.println("Yes");
        }
        else{
            System.out.println("No");
        }
    }
}