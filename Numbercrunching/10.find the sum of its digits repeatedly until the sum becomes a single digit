import java.util.*;

public class Main{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        long num = sc.nextLong();
        while(num>=10){
            long sum =0;
            while(num !=0){
                long temp = num%10;
                sum = sum+temp;
                num/=10;
            }
            num = sum;
        }
        System.out.print(num);
    }
}