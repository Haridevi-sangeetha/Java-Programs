import java.util.*;

public class Main{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        long num = sc.nextLong();
        int coun1 = 0, coun2 = 0,   coun3 = 0,  coun4 = 0,  coun5 = 0,  coun6 = 0,  coun7 = 0,  coun8 = 0,  coun9 = 0,  coun0 = 0;
        while(num != 0){
            long temp = num%10;
            if(temp  == 1){
                coun1++;
            }
            else if (temp==2){
                coun2++;
            }
            else if (temp==3){
                coun3++;
            }
            else if (temp==4){
                coun4++;
            }
            else if (temp==5){
                coun5++;
            }
            else if (temp==6){
                coun6++;
            }
            else if (temp==7){
                coun7++;
            }
            else if (temp==8){
                coun8++;
            }
            else if (temp==9){
                coun9++;
            }
            else if (temp==0){
                coun0++;
            }
            num= num/10;
        }
        System.out.println(0+" : "+coun0);
        System.out.println(1+" : "+coun1);
        System.out.println(2+" : "+coun2);
        System.out.println(3+" : "+coun3);
        System.out.println(4+" : "+coun4);
        System.out.println(5+" : "+coun5);
        System.out.println(6+" : "+coun6);
        System.out.println(7+" : "+coun7);
        System.out.println(8+" : "+coun8);
        System.out.println(9+" : "+coun9);
        
    }
}