import java.util.Scanner;

class StudentGrade{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        int row = sc.nextInt();
        int col = sc.nextInt();
        int [][] Result = new int[row][col];
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                Result[i][j] = sc.nextInt();
            }
        }    

        System.out.println("Student Averages: ");

        for(int i=0;i<row;i++){
            int sum=0;
            for(int j=0;j<col;j++){
                sum+=Result[i][j];
            }
            double avg = (double)sum/(double)col;
            System.out.printf("Student: "+(i+1)+":"+"%.0f%n",(avg)*100);
        }
        
        System.out.println("Subject Averages: ");
        
        for(int j=0;j<col;j++){
            int sum =0;
            for(int i=0;i<row;i++){
                sum+=Result[i][j];
            }
            double avg = (double)sum/(double)row;
            System.out.printf("Student"+(j+1)+":"+"%.0f%n",avg*100);
        }
    }
}
