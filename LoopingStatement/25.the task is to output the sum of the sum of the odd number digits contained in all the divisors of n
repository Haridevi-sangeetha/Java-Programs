import java.util.*;

public class Main{
    public static void main(String [] ags){
        Scanner sc = new Scanner(System.in);
        int q = sc.nextInt();
        for(int i=1;i<=q;i++){
            int val = sc.nextInt();
            int sum =0;
            for(int j=1;j<=val;j++){
                if(val%j==0){
                    int k = j;
                    while(k>0){
                        int temp = k%10;
                        if(temp%2 !=0){
                            sum +=temp;
                        }
                        k=k/10;
                    }
                }
            }
            System.out.println(sum);
        }
    }
}