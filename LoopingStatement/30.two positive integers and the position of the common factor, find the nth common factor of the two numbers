import java.util.Scanner;

public class Main{
    public static void main(String [] args){
        Scanner sc= new Scanner(System.in);
        long num1 = sc.nextInt();
        long num2=sc.nextInt();
        int position=sc.nextInt();
        long min=0;
        if(num1<num2){
            min=num1;
        }
        else{
            min=num2;
        }
        int count=0;
        for(int i=1;i<=min;i++){
            if(num1%i==0 && num2%i==0){
                count++;
                if(count==position){
                    System.out.println(i+" ");
                    break;
                }
            }
        }
    }
}