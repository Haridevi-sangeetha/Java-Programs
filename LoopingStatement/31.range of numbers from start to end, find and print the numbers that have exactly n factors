import java.util.Scanner;

public class Main{
    public static void main(String [] args){
        Scanner sc=new Scanner(System.in);
        long start=sc.nextInt();
        long end = sc.nextInt();
        int fact=sc.nextInt();
        for(long i=start;i<=end;i++){
            int count=0;
            for(int j=1;j<=i;j++){
                if(i%j==0){
                    count++;
                }
            }
            if(count==fact){
                System.out.print(i+" ");
            }
        }
    }
}