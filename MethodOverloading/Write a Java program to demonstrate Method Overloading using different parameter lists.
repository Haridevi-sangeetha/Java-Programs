
Method Overloading : creating a method with same name differ from length of parameter's arguments or data type . 

import java.util.*;

public class Main{
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();
        float d = sc.nextFloat();
        System.out.println( MethodOverload.add(a,b));
        System.out.println( MethodOverload.add(a,b,c));
         MethodOverload obj = new  MethodOverload();
        System.out.println(obj.add(a,d));
    }
}

class MethodOverload{
    public static int add(int a , int b){
        int add = a+b;
        return add;
    }
    public static int add(int a,int b,int c){
        int add = a+b+c;
        return add;
    }
    public int add(int a , float b){
        int add = a + (int) b;
        return add;
    }
}
